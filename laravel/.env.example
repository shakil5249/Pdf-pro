APP_NAME=PDFProTools
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pdfprotools.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pdfprotools_db
DB_USERNAME=pdfprotools_user
DB_PASSWORD=YOUR_SECURE_PASSWORD_HERE

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# SMTP MAIL CONFIGURATION (Invoice, signatures notifications)
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=SECURE_MAIL_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# PDF processing environment (set binary paths if required on cPanel)
GHOSTSCRIPT_PATH="/usr/bin/gs"
IMAGICK_BINARY_PATH="/usr/bin/convert"
pdftoppm_PATH="/usr/bin/pdftoppm"

# Gemini AI Credentials for Advanced Tools
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
